  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastnacek/pi-google-cca.git"
  },
  "homepage": "https://github.com/mastnacek/pi-google-cca",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
