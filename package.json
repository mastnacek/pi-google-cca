{
  "name": "pi-google-cca",
  "version": "1.1.1",
  "type": "module",
  "description": "Google Cloud Code Assist & Antigravity OAuth for pi — browser OAuth login for Google & Antigravity models (Gemini 3.x/2.5, Claude Sonnet/Opus 4.6/4.5, GPT-OSS 120B), streaming via the Cloud Code Assist wire API with quota tracking and dynamic model discovery.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "google",
    "gemini",
    "oauth",
    "cloud-code-assist",
    "antigravity",
    "claude"
  ],
  "license": "MIT",
  "author": "mastnacek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastnacek/pi-google-cca.git"
  },
  "homepage": "https://github.com/mastnacek/pi-google-cca",
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typescript": "^5.8.0"
  }
}
